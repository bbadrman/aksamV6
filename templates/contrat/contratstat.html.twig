{% extends 'base.html.twig' %}
{% block body %}
	{% for label,  messages in app.flashes  %}
		<div class="container">
			<div class="alert alert-{{ label }}">
				{% for message in messages %}
					{{ message | raw }}
				{% endfor %}

			</div>
		</div>
	{% endfor %}
	{% for message in app.flashes('warning') %}
		<div class="alert alert-warning">
			{{ message }}
		</div>
	{% endfor %}
	<div class="row mt">
		<div class="col-lg-12">
			<div class="content-panel">
				<section class="content-header">

					<h1 style="text-align: center;">Chiffres d'Affaires</h1>


					<ol class="breadcrumb">
						<li>
							<a href="{{ path('dashboard') }}">
								<i class="fa fa-dashboard"></i>
								Tableau de bord</a>
						</li>
						<li class="active">
							<a href="{{ path('app_table_liste') }}">
								<i class="fa fa-users"></i>
								Toutes les Tables</a>
						</li>
						<!-- NOTIFICATION DROPDOWN -->
						<li id="header_notification_bar" class="dropdown">
							<a data-toggle="dropdown" class="dropdown-toggle" href="#">
								<i class="fa fa-shopping-cart"></i>
								<span class="badge bg-warning">{{ contrats|length }}
								</span>
							</a>

						</li>
						<!-- END NOTIFICATION DROPDOWN -->
					</ol>
					<br>
				</section>
				<div style="text-align: right;">

					<button type="button" type="button" class="btn btn-theme">
						<a href="{{ path('contratstat_mont') }}">MENSUELLE</a>
					</button>
				</div>
				<div class="col-xs-12" style="float: center !important;">
					<div class="row" style="margin-right: 10px;">{% include 'contrat/_search_form_contrat.html.twig' with {search_form: search_form} only %}
					</div>
				</div>


				{% if contratsParComrcl is not empty %}

					<table id="table-datatables" class="display">
						<thead>
							<tr>
								<th>Commercial</th>
								<th>Nombre de contrats</th>
								<th>Total des frais</th>
								<th>1er reglement</th>
								<th>2eme reglement</th>
							</tr>
						</thead>
						<tbody>
							{% for comrcl in contratsParComrcl %}
								<tr>
									<td>
										{% if app.user == comrcl.commercial or  is_granted('ROLE_VALIDE') or is_granted('ROLE_ADMIN')  %}
											<button class="btn btn-info btn-details" data-commercial="{{ comrcl.commercial }}" data-startdate="{{ search_form.vars.data.startDate|date('Y-m-d') }}" data-enddate="{{ search_form.vars.data.endDate|date('Y-m-d') }}">
												{{ comrcl.commercial }}
											</button>
										{% else %}
											{{ comrcl.commercial }}
										{% endif %}
									</td>

									<td>{{ comrcl.contratCount }}</td>
									<td>{{ comrcl.totalFrais | number_format(2, ',', ' ') }}
										€</td>
									<td>{{ comrcl.totalFirstReglement | number_format(2, ',', ' ') }}
										€</td>
									<td>{{ comrcl.totalSecondReglement | number_format(2, ',', ' ') }}
										€</td>
								</tr>
							{% endfor %}

						</tbody>
						<tr>

							<td>Total</td>

							<td>
								<h3>
									{{ totalContrats }}</h3>
							</td>
							<td>
								<h3>
									<strong>{{ totalFrais | number_format(2, ',', ' ') }}</strong>
									€</h3>
							</td>
							{# <td>
																																																																									<h3>
																																																																										<strong>{{ totalFirstReglm | number_format(2, ',', ' ') }}</strong>
																																																																										€</h3>
																																																																								</td>
																																																																								<td>
																																																																									<h3>
																																																																										<strong>{{ totalSecondReglm | number_format(2, ',', ' ') }}</strong>
																																																																										€</h3>
																																																																								</td> #}


						</tr>
					</table>

				{% else %}
					<p>Aucun contrat trouvé pour cette période.</p>
				{% endif %}
			</div>
		</div>
		<div id="details-container" style="margin-top: 20px;">
			<h3>Détails des Contrats</h3>
			<table id="details-table" class="display table-large">
				<thead>
					<tr>
						<th>ID</th>
						<th>Client</th>
						<th>Date Souscription</th>
						<th>Frais</th>
						<th>1er Règlement</th>
						<th>2e Règlement</th>
					</tr>
				</thead>
				<tbody id="details-body"></tbody>
			</table>
		</div>
	{% endblock %}
	{% block javascripts %}
		{{ parent() }}<script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
		<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
		<script src='/js/adaffect.js'></script>
	{% endblock %}
